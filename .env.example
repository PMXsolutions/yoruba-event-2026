# Promax Event Platform — environment template
# Copy to `.env.local` and fill with values from your providers.
# Never commit real secrets or service role keys to git.

# ── Promax Event Platform ──────────────────────────────────────────
# Active event configuration (defaults to yoruba-day-canberra-2026)
EVENT_SLUG=yoruba-day-canberra-2026

# ── Supabase (database + auth) ─────────────────────────────────────
# Project URL (public) — use https://<ref>.supabase.co only (no /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=

# Anon (public) key — browser + SSR auth clients
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server only. Never expose to the browser or NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=

# Preferred From header, e.g. Promax Event <support@promaxcare.com.au>
MAIL_FROM=
MAIL_FROM_NAME=Promax Event

# Legacy alias (still supported if MAIL_FROM is unset)
# RESEND_FROM_EMAIL=

# Optional SMTP compatibility (not used by default Resend transport)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ── Admin bootstrap ────────────────────────────────────────────────
# Used only by scripts/provision-admin.mjs — never commit real passwords.
# ADMIN_EMAIL=admin@promaxevent.com
# ADMIN_PASSWORD=
# ADMIN_FULL_NAME=Platform Administrator

# ── Development-only health insert test ────────────────────────────
# ENABLE_RSVP_INSERT_TEST=false

# ── Twilio (SMS) — future, not active in v1 ────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# NOTIFY_SMS_ENABLED=false

# ── AI — future, not active in v1 ──────────────────────────────────
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_ENABLED=false
