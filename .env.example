# Promax Event Platform — environment template
# Copy to `.env.local` and fill with values from your providers.
# Never commit real secrets or service role keys to git.

# ── Promax Event Platform ──────────────────────────────────────────
# Active event configuration (defaults to yoruba-day-canberra-2026)
EVENT_SLUG=yoruba-day-canberra-2026

# ── SQL Server (Promax IT Solutions) ───────────────────────────────
# Named instance on this Windows PC. One backslash: VMI3197632\SQLEXPRESS.
# The app keeps that name for TLS. The TCP socket stays on this PC because the
# computer name resolves off the machine, and Node rejects an IP as a TLS name.
# Do not commit the password. Do not write the server name with two backslashes.
MSSQL_SERVER=VMI3197632\SQLEXPRESS
MSSQL_DATABASE=YorubaDayCanberra
MSSQL_USER=yorubaday_admin
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
# Optional when the instance is not already included in MSSQL_SERVER:
# MSSQL_INSTANCE=SQLEXPRESS

# Optional single connection string. When set, it overrides the parts above.
# The server value uses one backslash.
# MSSQL_CONNECTION_STRING=Server=VMI3197632\SQLEXPRESS;Database=YorubaDayCanberra;User Id=yorubaday_admin;Password=;Encrypt=true;TrustServerCertificate=true;

# Signs the committee session cookie. At least 32 characters. Server only.
SESSION_SECRET=

# Public origin used in invitation and password-reset links.
# NEXT_PUBLIC_SITE_URL=https://yorubadaycanberra.org

# ── Email ──────────────────────────────────────────────────────────
# Display name / From header. Prefer full form: Promax Event <support@example.com>
# If MAIL_FROM is only a display name, SMTP_USER is used as the address.
MAIL_FROM="Promax Event <support@promaxcare.com.au>"
MAIL_FROM_NAME=Promax Event

# SMTP (preferred when configured — used for RSVP confirmation emails)
# A vanity hostname is fine. TLS is checked against its CNAME target when the
# certificate is issued to the shared host (mail.promaxcare.com.au → *.site4now.net).
SMTP_HOST=mail.promaxcare.com.au
SMTP_PORT=587
SMTP_USER=support@promaxcare.com.au
SMTP_PASSWORD=
# SMTP_SECURE=false

# Optional aliases accepted by the app (same meaning as above):
# SMTPMail=mail.promaxcare.com.au
# MAIL_SENDER=support@promaxcare.com.au
# SMTP_Password=

# Resend (optional alternative when SMTP is not set)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# ── Admin bootstrap ────────────────────────────────────────────────
# Create the SUPER_ADMIN in SQL Server (never commit real passwords):
#   npm run db:migrate
#   npm run provision-admin
ADMIN_EMAIL=admin@promaxevent.com
ADMIN_FULL_NAME=Platform Administrator
# Quote the password if it contains # or spaces:
ADMIN_PASSWORD=

# ── Feature flags (controlled public launch) ───────────────────────
PUBLIC_REGISTRATION_OPEN=true
EMAIL_CONFIRMATIONS_ENABLED=true
SMS_ENABLED=false
DASHBOARD_AUTH_REQUIRED=true

# ── Development-only health insert test ────────────────────────────
# ENABLE_RSVP_INSERT_TEST=false

# ── SMS ────────────────────────────────────────────────────────────
# Prefer Dashboard → Settings → SMS settings. Values below are used only
# when that screen has not saved a row for the event. Never commit passwords.
# NOTIFY_SMS_ENABLED=false   # alias accepted for SMS_ENABLED
#
# DirectSMS (https://api.directsms.com.au/s3/http/send_message)
# DIRECTSMS_USERNAME=
# DIRECTSMS_PASSWORD=
# DIRECTSMS_SENDER_ID=YCD
# DIRECTSMS_URL=https://api.directsms.com.au/s3/http/send_message
# DIRECTSMS_TYPE=1-way
# DIRECTSMS_COUNTRY_CODE=61
#
# Twilio, used when the dashboard provider is Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ── AI — future, not active in v1 ──────────────────────────────────
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_ENABLED=false
