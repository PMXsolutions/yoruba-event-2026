<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <!-- cmd.exe is always present. start-node.cmd launches the installed node.exe.
         processPath="node" fails with 502.3 / 0x80070002 because the IIS app pool
         does not inherit a user PATH. -->
    <httpPlatform processPath="C:\Windows\System32\cmd.exe"
                  arguments="/d /c .\start-node.cmd"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node"
                  startupTimeLimit="120"
                  processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="HOSTNAME" value="127.0.0.1" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
